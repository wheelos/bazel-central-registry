load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

cc_library(
    name = "livekit_sdk_linux_x86_64",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = ["@livekit_linux_x86_64//:livekit_sdk"],
)

filegroup(
    name = "runtime_libs_linux_x86_64",
    srcs = ["@livekit_linux_x86_64//:runtime_libs"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

cc_library(
    name = "livekit_sdk_linux_aarch64",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    deps = ["@livekit_linux_aarch64//:livekit_sdk"],
)

filegroup(
    name = "runtime_libs_linux_aarch64",
    srcs = ["@livekit_linux_aarch64//:runtime_libs"],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

cc_library(
    name = "livekit_sdk",
    deps = select({
        ":linux_aarch64": [":livekit_sdk_linux_aarch64"],
        ":linux_x86_64": [":livekit_sdk_linux_x86_64"],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

filegroup(
    name = "runtime_libs",
    srcs = select({
        ":linux_aarch64": [":runtime_libs_linux_aarch64"],
        ":linux_x86_64": [":runtime_libs_linux_x86_64"],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
